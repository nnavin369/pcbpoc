# =============================================================================
# .env.example — Environment Variables Template
#
# This is a SAFE TEMPLATE to commit to Git.
# It shows what variables are needed WITHOUT exposing real credentials.
#
# HOW TO USE:
#   1. Copy this file and rename it to .env
#      Command: copy .env.example .env
#   2. Fill in the real values in your .env file
#   3. Never commit your .env file to Git
# =============================================================================

# Application URL
BASE_URL=https://your-app-url.com

# Valid credentials — used for successful login and all dashboard tests
VALID_USERNAME=your_username
VALID_PASSWORD=your_password

# Invalid credentials — used for negative login tests
INVALID_USERNAME=invalid_user
INVALID_PASSWORD=wrong_password

# Browser settings
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=80

# Timeouts (in milliseconds)
TIMEOUT_DEFAULT=120000
TIMEOUT_LOGIN=120000
TIMEOUT_ELEMENT=15000
TIMEOUT_NAVIGATION=120000
